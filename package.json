{
    "name":  "kotoba-compass",
    "version":  "1.0.0",
    "private":  true,
    "packageManager":  "pnpm@11.18.0",
    "scripts":  {
                    "build":  "pnpm --recursive run build",
                    "typecheck":  "pnpm --recursive run typecheck",
                    "lint":  "eslint .",
                    "format":  "prettier --write .",
                    "format:check":  "prettier --check ."
                },
    "devDependencies":  {
                            "@eslint/js":  "^9.0.0",
                            "eslint":  "^9.0.0",
                            "eslint-config-prettier":  "^10.0.0",
                            "globals":  "^16.0.0",
                            "prettier":  "^3.0.0",
                            "typescript-eslint":  "^8.0.0"
                        }
}
